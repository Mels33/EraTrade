# Mainnet. Хранить отдельно от testnet, с отдельным API-кошельком и отдельной БД.
ENVIRONMENT=mainnet
HYPERLIQUID_NETWORK=mainnet
# При старте допустимы только DISABLED, SHADOW или LIVE_PAUSED.
TRADING_MODE=DISABLED
MAINNET_CONFIRMATION=I_UNDERSTAND_REAL_MONEY

DATABASE_URL=postgresql+asyncpg://eratrade:CHANGE_ME@127.0.0.1:5435/eratrade_mainnet

# HL_ACCOUNT_ADDRESS=0x...
# HL_API_WALLET_PRIVATE_KEY=

# LOGFIRE_TOKEN=
LOG_LEVEL=info
