# Скопировать в .env для локальной работы с testnet.
ENVIRONMENT=testnet
HYPERLIQUID_NETWORK=testnet
TRADING_MODE=DISABLED

DATABASE_URL=postgresql+asyncpg://eratrade:eratrade_local@127.0.0.1:5435/eratrade_testnet

# Адрес основного аккаунта/субаккаунта (не API-кошелька). Заполним на этапе 3.
# HL_ACCOUNT_ADDRESS=0x...
# Ключ testnet API-кошелька. Понадобится на этапе 5. Никогда не коммитить.
# HL_API_WALLET_PRIVATE_KEY=

# LOGFIRE_TOKEN=
LOG_LEVEL=info
